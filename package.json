{
  "name": "daily-companion-devbuild",
  "version": "0.3.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start --dev-client",
    "start:tunnel": "expo start --dev-client --tunnel",
    "start:expo-go-fallback": "expo start",
    "build:android:dev": "eas build --platform android --profile development",
    "build:android:preview": "eas build --platform android --profile preview",
    "doctor": "npx expo-doctor",
    "fix:deps": "npx expo install --fix"
  },
  "dependencies": {
    "expo": "56.0.11",
    "expo-dev-client": "latest",
    "expo-notifications": "latest",
    "@react-native-async-storage/async-storage": "2.2.0",
    "react": "19.2.3",
    "react-native": "0.85.3"
  },
  "devDependencies": {
    "@babel/core": "^7.26.9"
  }
}